# ========================================
# Claudio — environment variables template
# ========================================
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets.

# ----------------------------------------
# Anthropic (the brain)
# ----------------------------------------
# Production mode: get a key from https://console.anthropic.com/settings/keys
# Local development can skip this if using Claude Code subprocess.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which brain to use:
#   "subprocess" — local dev, spawns Claude Code (uses your Pro plan, no API cost)
#   "api"        — production, calls Anthropic API (requires ANTHROPIC_API_KEY)
BRAIN_MODE=subprocess

# Model to use when BRAIN_MODE=api
# Recommended: claude-haiku-4-5 (cheap and fast, ~$0.005 per DJ invocation)
ANTHROPIC_MODEL=claude-haiku-4-5

# ----------------------------------------
# Spotify (the music source)
# ----------------------------------------
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Must match a Redirect URI registered in your Spotify app settings
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# ----------------------------------------
# Google Calendar (optional, for calendar-aware scheduling)
# ----------------------------------------
# Get these from https://console.cloud.google.com — leave blank to skip calendar context
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/google/callback

# ----------------------------------------
# OpenWeather (optional, for weather context)
# ----------------------------------------
# Free tier: https://openweathermap.org/api — leave blank to skip weather context
OPENWEATHER_API_KEY=

# Your location for weather lookup (default: London, Ontario, Canada)
WEATHER_LAT=42.9849
WEATHER_LON=-81.2453

# ----------------------------------------
# Server configuration
# ----------------------------------------
# Backend port (the Node.js brain server)
PORT=3000

# Node environment: "development" | "production" | "test"
# Used to gate dev-only features like verbose logging
NODE_ENV=development

# Frontend port (Vite dev server)
CLIENT_PORT=5173

# Local SQLite database file (gitignored, persists across restarts)
DATABASE_PATH=./data/claudio.db